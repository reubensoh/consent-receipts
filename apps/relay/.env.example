# Copy to apps/relay/.env on the PO's machine only. Never commit .env.
OPENAI_API_KEY=               # PO's personal account, spend-capped, placed here by the PO only
OPENAI_MODEL=                 # a mini-class model; see docs/QUESTIONS.md B2
ORG_KEYPAIR_PATH=.keys/org.json
SOLANA_RPC_URL=https://api.devnet.solana.com
CONSENT_ANCHOR_PROGRAM_ID=    # from Anchor.toml after first deploy
SESSION_SECRET=               # 32 random bytes, hex; HMAC for session tokens
RATE_LIMIT_PER_MINUTE=10
